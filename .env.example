# Required for LIVE mode (real LLM calls). Leave unset to run in MOCK mode.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Model + generation settings (e.g. gemini-3.6-flash, claude-sonnet-5)
AGENTICLOOPQA_MODEL=gemini-3.5-flash
AGENTICLOOPQA_MAX_TOKENS=1024
AGENTICLOOPQA_TEMP_GEN=0.4
AGENTICLOOPQA_TEMP_CRITIC=0.0

# Force mock mode explicitly (1/0). Defaults to 1 automatically if
# ANTHROPIC_API_KEY is unset.
AGENTICLOOPQA_MOCK=

# Self-correction loop
AGENTICLOOPQA_MAX_ITERS=3
AGENTICLOOPQA_STOP_CONF=0.85

# Retrieval (vector / local / web / hybrid)
AGENTICLOOPQA_RETRIEVER_TYPE=vector
AGENTICLOOPQA_TOP_K=3
AGENTICLOOPQA_CORPUS=

# Optional: live Web Search API keys (DuckDuckGo is used by default for free)
TAVILY_API_KEY=
AGENTICLOOPQA_SEARCH_API_KEY=

AGENTICLOOPQA_VERBOSE=1
